{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../src",
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationDir": "../../dist/types",
    "outDir": "../../dist/es",
    "sourceMap": true,
    "inlineSources": true,
    "allowImportingTsExtensions": false,
    "module": "ESNext",
    "target": "ES2022",
    "jsx": "react-jsx",
    "noEmit": false
  },
  "include": ["../../src/**/*"],
  "exclude": [
    "../../src/**/*.stories.tsx",
    "../../src/**/*.test.ts",
    "../../src/**/*.test.tsx",
    "../../src/**/*.mdx",
    "../tests/specs/**/*",
    "../build/scripts/**/*",
    "../../boilerplate-example/**/*",
    "../../public/**/*",
    "../storybook/**/*"
  ]
}
